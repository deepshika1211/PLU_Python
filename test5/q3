import sqlite3

class Transaction:
    def __init__(self, tid, account, amount, date, ttype):
        self.tid = tid
        self.account = account
        self.amount = amount
        self.date = date
        self.ttype = ttype

    def display(self):
        print("Transaction ID :", self.tid)
        print("Account Number :", self.account)
        print("Amount         :", self.amount)
        print("Date           :", self.date)
        print("Type           :", self.ttype)
        print("-" * 30)

