cur.execute("SELECT * FROM transactions")
rows = cur.fetchall()

transactions = []

for row in rows:
    transactions.append(Transaction(*row))

def quick_sort(arr):
    if len(arr) <= 1:
        return arr

    pivot = arr[len(arr)//2].amount

    left = [x for x in arr if x.amount < pivot]
    middle = [x for x in arr if x.amount == pivot]
    right = [x for x in arr if x.amount > pivot]

    return quick_sort(left) + middle + quick_sort(right)

sorted_transactions = quick_sort(transactions)

print("Transactions Sorted by Amount")
print("-" * 30)

for t in sorted_transactions:
    t.display()

transactions_by_id = sorted(transactions, key=lambda x: x.tid)

def binary_search(arr, key):
    low = 0
    high = len(arr) - 1

    while low <= high:
        mid = (low + high) // 2

        if arr[mid].tid == key:
            return arr[mid]
        elif arr[mid].tid < key:
            low = mid + 1
        else:
            high = mid - 1

    return None

tid = int(input("Enter Transaction ID: "))

result = binary_search(transactions_by_id, tid)

if result:
    print("\nTransaction Found")
    result.display()
else:
    print("Transaction Not Found")

